#!/bin/sh
#
# Runs four checks and refuses the commit when any refuses it:
# - the per-story manifest, .claude/manifest/<WORK-ID>.xml, must list what the
#   commit records; the refusal prints the command that copies the rebuilt
#   file into place;
# - every Collection Filter condition a flow records must be one Flow Builder
#   can display;
# - a flow must not add Get Records reads of the feature toggle types where
#   the flow rule "Feature toggles in flows" forbids them, when the toggle
#   package is installed in the development org (a cached answer; this hook
#   never calls the org);
# - an Apex class must carry a class comment that follows "Class header" in
#   apex-docstring-comments.md, on a branch whose name holds a work ID.
# Installed by hean-harness setup in an SFDX repository whose .githooks/
# folder git does not track. The checks live in a fixed folder setup refreshes
# on every run, because the plugin's folder moves when it updates; no folder
# means the plugin was uninstalled, and this hook does nothing. Only a check's
# refusal, exit 3, refuses the commit; a check that crashes lets it through.
# pre-commit-checks.mjs runs all four in one node process and ends 80 (none
# refused) or 83 (one refused), printing through descriptor 3; any other end of
# it runs them one by one below, printing exactly what they print. Claude Code
# sets CLAUDE_CODE_CHILD_SESSION only in commands it runs itself, not in IDE
# terminals, and its own hooks have already checked those commits.

[ "${CLAUDE_CODE_CHILD_SESSION:-}" = 1 ] && exit 0
config="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
case "$config" in "~") config="$HOME" ;; "~/"*) config="$HOME/${config#\~/}" ;; esac
manifest="$config/hean-harness/hooks/scripts/lib/manifest-check.mjs"
filter="$config/hean-harness/hooks/scripts/lib/flow-collection-filter.mjs"
toggle="$config/hean-harness/hooks/scripts/lib/flow-feature-toggle.mjs"
header="$config/hean-harness/hooks/scripts/lib/apex-class-header.mjs"
command -v node >/dev/null 2>&1 || exit 0
runner="$config/hean-harness/hooks/scripts/lib/pre-commit-checks.mjs"; if [ -f "$runner" ]; then ( node "$runner"; exit $? ) 3>&2 2>/dev/null; case $? in 80) exit 0 ;; 83) exit 1 ;; esac; fi
refused=0
if [ -f "$manifest" ]; then
  node "$manifest" --git-hook
  [ $? -eq 3 ] && refused=1
fi
if [ -f "$filter" ]; then
  node "$filter" --git-hook
  [ $? -eq 3 ] && refused=1
fi
if [ -f "$toggle" ]; then
  node "$toggle" --git-hook
  [ $? -eq 3 ] && refused=1
fi
if [ -f "$header" ]; then
  node "$header" --git-hook
  [ $? -eq 3 ] && refused=1
fi
[ "$refused" -eq 1 ] && exit 1
exit 0
