#!/bin/sh
#
# Runs two checks and refuses the commit when either refuses it:
# - the per-story manifest, .claude/manifest/<WORK-ID>.xml, must list what the
#   commit records; the refusal prints the command that copies the rebuilt
#   file into place;
# - every Collection Filter condition a flow records must be one Flow Builder
#   can display.
# Installed by hean-harness setup in an SFDX repository whose .githooks/
# folder git does not track.
#
# The checks live in a fixed folder setup refreshes on every run, because the
# plugin's own folder moves when the plugin updates. When it is missing, the
# plugin was uninstalled, and this hook does nothing. Only the check's
# refusal, exit 3, refuses the commit: a crash in node (a partial copy, an
# unsupported node) lets it through, as every other "cannot run" case does.
#
# Claude Code sets CLAUDE_CODE_CHILD_SESSION only in commands it runs itself,
# not in IDE terminals, and its own hooks have already checked those commits.

[ "${CLAUDE_CODE_CHILD_SESSION:-}" = 1 ] && exit 0
config="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
case "$config" in "~") config="$HOME" ;; "~/"*) config="$HOME/${config#\~/}" ;; esac
manifest="$config/hean-harness/hooks/scripts/lib/manifest-check.mjs"
filter="$config/hean-harness/hooks/scripts/lib/flow-collection-filter.mjs"
command -v node >/dev/null 2>&1 || exit 0
refused=0
if [ -f "$manifest" ]; then
  node "$manifest" --git-hook
  [ $? -eq 3 ] && refused=1
fi
if [ -f "$filter" ]; then
  node "$filter" --git-hook
  [ $? -eq 3 ] && refused=1
fi
[ "$refused" -eq 1 ] && exit 1
exit 0
